{
  "name": "dsh-reject-message",
  "version": "0.1.0",
  "description": "Take over the native DSH approval window so a reject can carry a description the model will see.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.naming.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:host": "tsdown --config tsdown.host.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "build": "pnpm run build:host && pnpm run build:client",
    "test": "node --test tests/*.test.ts",
    "check:client": "node scripts/check-client.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:client"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.5-rc.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-registry": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-registry": "^0.1.5-rc.1",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "reject",
    "web-ui"
  ]
}
